{
  "id": "bosch_bth_ra",
  "name": "Bosch Radiator Thermostat II (BTH-RA)",
  "kind": "valve",
  "match": {
    "manufacturer": [
      "Bosch"
    ],
    "model_id": [
      "BTH-RA"
    ]
  },
  "roles": {
    "z2m": {
      "valve_read": {
        "expose": "pi_heating_demand"
      },
      "valve_write": {
        "expose": "pi_heating_demand"
      },
      "external_temperature": {
        "expose": "remote_temperature"
      },
      "child_lock": {
        "expose": "child_lock"
      },
      "calibration_trigger": {
        "expose": "valve_adapt_process"
      },
      "calibration_status": {
        "expose": "valve_adapt_status"
      },
      "setpoint_source": {
        "expose": "setpoint_change_source"
      }
    }
  },
  "notes": [
    "No minimum opening on the device: if Home Assistant stops, the thermostat regulates on its own.",
    "remote_temperature must be sent at least every 30 minutes.",
    "A written valve position is only kept for 15 minutes; Thermogeist confirms it every 10 minutes."
  ],
  "control_settings": {
    "z2m": [
      {
        "expose": "operating_mode",
        "value": "manual"
      }
    ]
  },
  "valve_write_refresh_minutes": 10,
  "setpoint_control_settings": {
    "z2m": [
      {
        "expose": "operating_mode",
        "value": "manual"
      }
    ]
  }
}
